#!/usr/bin/env python3
"""Fetch monday.com work assigned to you, plus per-board status rollups.

Emits a single JSON object on stdout for the Omarchy shell plugin to render.
Nothing here is monday-account specific: board layouts differ wildly, so the
person / status / date columns are discovered by type on every run rather than
hardcoded, and "which label counts as Done" is read from the board's own
`done_colors` setting instead of guessed from English label text.

Config (all optional):
  ~/.config/omarchy/monday/token    API token, or $MONDAY_API_TOKEN
  ~/.config/omarchy/monday/boards   one board id per line; falls back to the
                                    8 most recently used boards
"""

import errno
import json
import os
import pathlib
import stat
import sys
import urllib.error
import urllib.request

API = "https://api.monday.com/v2"
API_VERSION = "2024-10"
CONFIG_DIR = pathlib.Path.home() / ".config" / "omarchy" / "monday"
DEFAULT_BOARD_LIMIT = 8
ITEMS_PAGE = 100
MAX_ITEMS_PER_BOARD = 1000
TIMEOUT = 25

# Byte and length ceilings. The item limits above bound how many rows are
# looked at, which is not the same as bounding how many bytes arrive: one
# oversized field in one row is enough. So every point where bytes enter this
# process from the network, and every string that leaves it on stdout, is
# capped independently of the row count. The shell buffers whatever this
# process writes, so its memory is bounded by MAX_OUTPUT_BYTES.
MAX_RESPONSE_BYTES = 8 * 1024 * 1024
MAX_ERROR_BODY_BYTES = 4096
MAX_OUTPUT_BYTES = 4 * 1024 * 1024

# The config files are small by nature: one token on one line, a handful of
# board ids. The ceilings are generous against any honest file and still small
# enough that a file swapped for something enormous is rejected rather than
# read into this process.
MAX_TOKEN_BYTES = 4096
MAX_BOARDS_FILE_BYTES = 64 * 1024
MAX_BOARDS = 24
MAX_LABELS_PER_BOARD = 60
MAX_NAME_CHARS = 200
MAX_BOARD_NAME_CHARS = 120
MAX_STATUS_CHARS = 80
MAX_URL_CHARS = 500
MAX_COLOR_CHARS = 32
MAX_DUE_CHARS = 32


def die(message, kind="error"):
    json.dump({"ok": False, "kind": kind, "error": message, "items": [], "boards": []}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def clip(value, limit):
    """Every string on stdout goes through here, so no single API field can
    outgrow its slot in the panel or the shell's stdout buffer."""
    text = str(value or "")
    return text if len(text) <= limit else text[:limit]


def read_capped(stream, limit):
    """Read at most `limit` bytes, and fail if the body would exceed it.

    Reading limit + 1 is what makes "too big" detectable without ever holding
    the oversized body: the read stops one byte past the ceiling.
    """
    raw = stream.read(limit + 1)
    if len(raw) > limit:
        die(
            "monday.com sent more than %d MB in a single response, which is far "
            "beyond anything this widget asks for. Refusing to buffer it."
            % (limit // (1024 * 1024)),
            kind="api",
        )
    return raw


def validated_token(value):
    """Reject a token that cannot go in an HTTP header, without echoing it.

    http.client refuses a header value containing CR/LF and raises a ValueError
    whose message quotes the whole value; a non-latin-1 character raises too.
    Either traceback would carry the token into stderr, so catch it here where
    the message can be written without interpolating the secret. A stray
    interior newline is the realistic case — .strip() removes a trailing one,
    but not one picked up mid-paste.
    """
    if any(c in value for c in "\r\n\t"):
        die(
            "The API token contains a line break. Check that "
            "~/.config/omarchy/monday/token holds the token on a single line "
            "and nothing else.",
            kind="auth",
        )
    if not all(32 <= ord(c) <= 126 for c in value):
        die(
            "The API token contains a non-printable or non-ASCII character. "
            "Re-copy it from monday → avatar → Developers → My access tokens.",
            kind="auth",
        )
    return value


def read_config_file(path, limit):
    """Read a config file through one descriptor that cannot be redirected,
    cannot block, and cannot outgrow `limit` bytes. Returns None if absent.

    Both config files live in a user-writable directory, so a path that was
    checked and a path that is later opened are not necessarily the same file.
    Nothing here is decided from the path: every check is made against the one
    descriptor whose bytes are actually read.

    O_NOFOLLOW refuses a symlink planted at the final component — at the token
    path that is the whole attack, since the contents are sent to monday.com as
    an Authorization header, so a link to any other file this user can read is
    enough to exfiltrate it. O_NONBLOCK means a planted FIFO or device node
    cannot park this helper inside open(), which matters because the shell runs
    it on a repeating timer and a blocked run holds the slot forever. fstat on
    the open descriptor then proves the thing about to be read is a plain file
    owned by this user — which also rejects a hard link to someone else's file,
    where there is no symlink to refuse. Only then is any byte read, and only
    up to the cap, so an oversized file is rejected without being buffered.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.EMLINK):
            die(
                "%s is a symbolic link. Refusing to read it — replace it with a "
                "regular file." % path,
                kind="config",
            )
        die("Could not open %s: %s" % (path, exc.strerror), kind="config")

    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            die(
                "%s is not a regular file. Refusing to read it — replace it with "
                "a regular file." % path,
                kind="config",
            )
        if info.st_uid != os.getuid():
            die(
                "%s is owned by another user (uid %d). Refusing to read it."
                % (path, info.st_uid),
                kind="config",
            )
        with os.fdopen(fd, "rb", closefd=False) as handle:
            raw = handle.read(limit + 1)
    finally:
        os.close(fd)

    if len(raw) > limit:
        die(
            "%s is larger than %d bytes, which no valid config file is. "
            "Refusing to read it." % (path, limit),
            kind="config",
        )
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        # Never interpolate the exception: it quotes the offending bytes, which
        # for the token file is the secret.
        die("%s is not valid UTF-8 text." % path, kind="config")


def read_token():
    env = os.environ.get("MONDAY_API_TOKEN", "").strip()
    if env:
        return validated_token(env)
    text = read_config_file(CONFIG_DIR / "token", MAX_TOKEN_BYTES)
    if text is not None:
        value = text.strip()
        if value:
            return validated_token(value)
    die(
        "No monday.com API token. Put one in ~/.config/omarchy/monday/token "
        "(monday → avatar → Developers → My access tokens).",
        kind="auth",
    )


def configured_boards():
    ids = [a.strip() for a in sys.argv[1:] if a.strip()]
    if ids:
        return ids
    text = read_config_file(CONFIG_DIR / "boards", MAX_BOARDS_FILE_BYTES)
    if text is None:
        return []
    out = []
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            out.append(line)
    return out


def gql(token, query, variables=None):
    body = json.dumps({"query": query, "variables": variables or {}}).encode("utf-8")
    request = urllib.request.Request(
        API,
        data=body,
        headers={
            "Content-Type": "application/json",
            "Authorization": token,
            "API-Version": API_VERSION,
            "User-Agent": "omarchy-monday-plugin/1.0",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            # "replace" rather than strict: a body that is not valid UTF-8 must
            # surface as the "not JSON" error below, not as a UnicodeDecodeError
            # caught by the ValueError branch and misreported as a bad token.
            raw = read_capped(response, MAX_RESPONSE_BYTES).decode("utf-8", "replace")
    except ValueError:
        # http.client raises ValueError/UnicodeEncodeError for a header value it
        # cannot send, and quotes the value in the message — which here is the
        # token. validated_token() should have caught this already; if it did
        # not, fail with a fixed string rather than let a traceback carrying the
        # secret reach stderr. Never interpolate this exception.
        die(
            "The API token is not a valid HTTP header value. Check "
            "~/.config/omarchy/monday/token.",
            kind="auth",
        )
    except urllib.error.HTTPError as exc:
        detail = exc.read(MAX_ERROR_BODY_BYTES).decode("utf-8", "replace")[:300]
        if exc.code in (401, 403):
            die("monday.com rejected the API token (%s). Check ~/.config/omarchy/monday/token." % exc.code, kind="auth")
        die("monday.com HTTP %s: %s" % (exc.code, detail), kind="http")
    except urllib.error.URLError as exc:
        die("Could not reach monday.com: %s" % exc.reason, kind="network")
    except (TimeoutError, OSError) as exc:
        die("Could not reach monday.com: %s" % exc, kind="network")

    try:
        payload = json.loads(raw)
    except ValueError:
        die("monday.com returned a response that is not JSON", kind="api")

    if payload.get("errors"):
        message = "; ".join(str(e.get("message", e)) for e in payload["errors"])[:300]
        die("monday.com API error: %s" % message, kind="api")
    data = payload.get("data")
    if data is None:
        die("monday.com returned no data", kind="api")
    return data


def parse_settings(raw):
    try:
        return json.loads(raw) if raw else {}
    except (TypeError, ValueError):
        return {}


def pick_person_column(columns):
    people = [c for c in columns if c["type"] == "people"]
    if not people:
        return None
    for column in people:
        if "owner" in column["title"].lower():
            return column
    return people[0]


def pick_status_column(columns):
    """Prefer a status column that declares done_colors, then one titled Status.

    Boards routinely carry several status columns (Status, Priority, Health).
    The one the board owner marked up with done labels is the one that means
    "is this finished", which is exactly what the rollup is counting.
    """
    statuses = [c for c in columns if c["type"] == "status"]
    if not statuses:
        return None
    with_done = [c for c in statuses if parse_settings(c.get("settings_str")).get("done_colors")]
    pool = with_done or statuses
    for column in pool:
        if column["title"].strip().lower() == "status":
            return column
    for column in pool:
        if "status" in column["id"].lower() or "status" in column["title"].lower():
            return column
    return pool[0]


def pick_date_column(columns):
    """A real due date beats a timeline end, which beats any other date column."""
    dates = [c for c in columns if c["type"] == "date"]
    for column in dates:
        title = column["title"].lower()
        if "due" in title or "deadline" in title or "target" in title:
            return column
    timelines = [c for c in columns if c["type"] == "timeline"]
    if timelines:
        return timelines[0]
    return dates[0] if dates else None


def column_value(item, column_id):
    for value in item.get("column_values") or []:
        if value["id"] == column_id:
            return value
    return None


def due_from(value):
    if not value:
        return ""
    parsed = parse_settings(value.get("value"))
    if not parsed:
        return ""
    if value.get("type") == "timeline" or "to" in parsed:
        return str(parsed.get("to") or "")
    return str(parsed.get("date") or "")


def status_index(value):
    if not value:
        return None
    parsed = parse_settings(value.get("value"))
    index = parsed.get("index")
    return index if isinstance(index, int) else None


class StatusMap:
    """Board-declared meaning for each status label index."""

    def __init__(self, column):
        settings = parse_settings(column.get("settings_str")) if column else {}
        self.labels = {str(k): str(v) for k, v in (settings.get("labels") or {}).items()}
        self.colors = settings.get("labels_colors") or {}
        self.done = {str(i) for i in (settings.get("done_colors") or [])}

    def color(self, index):
        entry = self.colors.get(str(index)) or {}
        return str(entry.get("color") or "")

    def var_name(self, index):
        entry = self.colors.get(str(index)) or {}
        return str(entry.get("var_name") or "")

    def kind(self, index, text):
        """done / stuck / open, from the board's own colour metadata."""
        if index is None and not text:
            return "open"
        key = str(index)
        if key in self.done:
            return "done"
        var_name = self.var_name(index)
        if "red" in var_name or "stuck" in str(text).lower():
            return "stuck"
        if not self.done and str(text).strip().lower() in ("done", "complete", "completed", "closed"):
            return "done"
        return "open"


BOARD_META = """
query ($ids: [ID!]) {
  boards(ids: $ids) {
    id
    name
    url
    type
    columns { id title type settings_str }
  }
}
"""

RECENT_BOARDS = """
query ($limit: Int!) {
  boards(limit: $limit, order_by: used_at, state: active) { id }
}
"""

MY_ITEMS = """
query ($board: ID!, $rules: ItemsQuery, $cols: [String!]) {
  boards(ids: [$board]) {
    items_page(limit: %d, query_params: $rules) {
      items {
        id
        name
        url
        column_values(ids: $cols) { id type text value }
      }
    }
  }
}
""" % ITEMS_PAGE

BOARD_ITEMS = """
query ($board: ID!, $cols: [String!]) {
  boards(ids: [$board]) {
    items_page(limit: %d) {
      cursor
      items { id column_values(ids: $cols) { id type text value } }
    }
  }
}
""" % ITEMS_PAGE

NEXT_ITEMS = """
query ($cursor: String!, $cols: [String!]) {
  next_items_page(limit: %d, cursor: $cursor) {
    cursor
    items { id column_values(ids: $cols) { id type text value } }
  }
}
""" % ITEMS_PAGE


def tally_board(token, board_id, column_id, status_map):
    """Page a board, folding each page into the counters as it arrives.

    A page is dropped before the next one is requested, so a board contributes
    four integers and at most MAX_LABELS_PER_BOARD short label names to memory
    rather than its items. Distinct labels are capped because the label name is
    API data: without a ceiling, a board whose status column has been filled
    with unique junk would grow this dict without limit.
    """
    counts = {"open": 0, "stuck": 0, "done": 0, "total": 0}
    labels = {}
    data = gql(token, BOARD_ITEMS, {"board": board_id, "cols": [column_id]})
    boards = data.get("boards") or []
    if not boards:
        return counts, labels
    page = boards[0].get("items_page") or {}
    while True:
        items = page.get("items") or []
        for item in items:
            value = column_value(item, column_id)
            index = status_index(value)
            text = clip((value or {}).get("text") or "", MAX_STATUS_CHARS)
            counts[status_map.kind(index, text)] += 1
            counts["total"] += 1
            key = text or "No status"
            if key in labels:
                labels[key]["count"] += 1
            elif len(labels) < MAX_LABELS_PER_BOARD:
                labels[key] = {
                    "label": key,
                    "count": 1,
                    "color": clip(status_map.color(index), MAX_COLOR_CHARS),
                }
        cursor = page.get("cursor")
        if not cursor or counts["total"] >= MAX_ITEMS_PER_BOARD:
            return counts, labels
        page = gql(token, NEXT_ITEMS, {"cursor": cursor, "cols": [column_id]}).get("next_items_page") or {}


def main():
    token = read_token()
    me = gql(token, "query { me { id name } }")["me"]
    my_id = str(me["id"])

    board_ids = configured_boards()
    if not board_ids:
        recent = gql(token, RECENT_BOARDS, {"limit": DEFAULT_BOARD_LIMIT})["boards"]
        board_ids = [str(b["id"]) for b in recent]
    board_ids = board_ids[:MAX_BOARDS]

    meta = gql(token, BOARD_META, {"ids": board_ids})["boards"] or []

    items_out = []
    boards_out = []

    for board in meta:
        # Subitem boards are shadows of their parent and would double-count.
        if board.get("type") == "sub_items_board" or board["name"].startswith("Subitems of "):
            continue

        columns = [
            {
                "id": c["id"],
                "title": str(c.get("title") or ""),
                "type": str(c.get("type") or ""),
                "settings_str": c.get("settings_str"),
            }
            for c in (board.get("columns") or [])
        ]
        person_col = pick_person_column(columns)
        status_col = pick_status_column(columns)
        date_col = pick_date_column(columns)
        status_map = StatusMap(status_col)

        wanted = [c["id"] for c in (status_col, date_col) if c]

        # --- My work -------------------------------------------------------
        if person_col:
            rules = {
                "rules": [
                    {
                        "column_id": person_col["id"],
                        "compare_value": ["person-%s" % my_id],
                        "operator": "any_of",
                    }
                ]
            }
            data = gql(token, MY_ITEMS, {"board": board["id"], "rules": rules, "cols": wanted})
            mine = ((data.get("boards") or [{}])[0].get("items_page") or {}).get("items") or []
            for item in mine:
                status_value = column_value(item, status_col["id"]) if status_col else None
                index = status_index(status_value)
                text = clip((status_value or {}).get("text") or "", MAX_STATUS_CHARS)
                kind = status_map.kind(index, text)
                if kind == "done":
                    continue
                items_out.append(
                    {
                        "id": str(item["id"]),
                        "name": clip(item.get("name") or "Untitled", MAX_NAME_CHARS),
                        "url": clip(item.get("url") or board.get("url") or "", MAX_URL_CHARS),
                        "board": clip(board["name"], MAX_BOARD_NAME_CHARS),
                        "boardId": str(board["id"]),
                        "status": text,
                        "statusColor": clip(status_map.color(index), MAX_COLOR_CHARS),
                        "kind": kind,
                        "due": clip(due_from(column_value(item, date_col["id"])), MAX_DUE_CHARS) if date_col else "",
                    }
                )

        # --- Board health --------------------------------------------------
        counts = {"open": 0, "stuck": 0, "done": 0, "total": 0}
        labels = {}
        if status_col:
            counts, labels = tally_board(token, board["id"], status_col["id"], status_map)

        boards_out.append(
            {
                "id": str(board["id"]),
                "name": clip(board["name"], MAX_BOARD_NAME_CHARS),
                "url": clip(board.get("url") or "", MAX_URL_CHARS),
                "counts": counts,
                "labels": sorted(labels.values(), key=lambda entry: -entry["count"]),
                "statusColumn": clip(status_col["title"], MAX_STATUS_CHARS) if status_col else "",
                "dateColumn": clip(date_col["title"], MAX_STATUS_CHARS) if date_col else "",
                "tracksMe": bool(person_col),
            }
        )

    items_out.sort(key=lambda entry: (entry["due"] == "", entry["due"], entry["name"]))

    payload = json.dumps(
        {
            "ok": True,
            "error": None,
            "me": {"id": my_id, "name": clip(me.get("name") or "", MAX_NAME_CHARS)},
            "items": items_out,
            "boards": boards_out,
        }
    )
    # Last line of defence for the shell, which buffers this stream whole: with
    # every field clipped and every list bounded above, exceeding this means an
    # assumption broke, so send the small error object instead of the payload.
    if len(payload) > MAX_OUTPUT_BYTES:
        die("The monday.com response was too large to render.", kind="api")
    sys.stdout.write(payload)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
